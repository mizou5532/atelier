{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "atelier", "database_id": "ebcab391-db5a-4407-bc42-a36ae7a3bba1", "migrations_dir": "migrations" }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCES_EQUIPE": "https://wild-shape-0c7f.cloudflareaccess.com",
    "ACCES_AUD": "7a555d10838123765f51150a4cc1cb2fc72cfbfeb0f370945e6b19153d770775",
    "ACCES_COURRIEL": "hamzahlal86@gmail.com",
    "ACCES_SERVICE_ID": "",
    "GEMINI_MODELE": "gemini-3.5-flash-lite"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] }
}
